# Shared git settings. Name, email and signing key live in ~/.gitconfig.local
# (created by install.sh, never committed).
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
	default = current
[pull]
	rebase = true
[diff]
	algorithm = patience
	colorMoved = default
[user]
	name = jesusidev
	email = jesus@guzman1.com
