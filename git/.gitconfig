# Shared git settings. Name, email and signing key live in ~/.gitconfig.local
# (created by install.sh, never committed).
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[core]
	# Faster `git status` in big repos (and the Starship prompt, which runs it):
	# a per-repo file watcher plus a cache of untracked files.
	fsmonitor = true
	untrackedCache = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
	default = current
[pull]
	rebase = true
[diff]
	algorithm = patience
	colorMoved = default
